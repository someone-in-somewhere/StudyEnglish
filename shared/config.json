    "daily_life": [
      "food",
      "shopping",
      "home",
      "health"
    ],
    "professional": [
      "business",
      "technology",
      "education",
      "work"
    ],
    "general": [
      "nature",
      "weather",
      "travel",
      "sports"
    ],
    "culture": [
      "music",
      "movies",
      "art",
      "literature"
    ],
    "specialized": [
      "science",
      "medicine",
      "law"
    ]
  },
  "quiz_types": [
    "multiple_choice",
    "fill_in_blank",
    "matching"
  ],
  "exercise_types": [
    "fill_in_blank",
    "rewriting",
    "translation",
    "word_order",
    "error_correction"
